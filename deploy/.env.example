# Settings for docker compose (copy to deploy/.env). Secrets live in ./secrets, not here.

# Public hostname. "localhost" uses a self-signed certificate from Caddy's internal CA;
# a real domain pointing at this host gets a Let's Encrypt certificate automatically.
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Which images to run (set by the deploy workflow; local builds use the same names).
IMAGE_PREFIX=ghcr.io/your-org/secureshare
TAG=latest

# The account with this username becomes the administrator when it registers.
# Register it immediately after the first deployment.
BOOTSTRAP_ADMIN=admin
REGISTRATION_OPEN=true
MAX_UPLOAD_BYTES=104857600
LOG_LEVEL=info
