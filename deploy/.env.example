# Settings for docker compose (copy to deploy/.env). Secrets live in ./secrets, not here.

# Public hostname. "localhost" uses a self-signed cert from deploy/nginx/certs/.
# A real domain pointing at this host gets a TLS certificate from Let's Encrypt.
DOMAIN=localhost

# Administrator email (used for TLS cert registration notifications if using certbot).
ACME_EMAIL=admin@example.com

# Which images to run (set by the deploy workflow; local builds use the same names).
IMAGE_PREFIX=ghcr.io/your-org/secureshare
TAG=latest

# The account with this username becomes the administrator when it registers.
# Register it immediately after the first deployment.
BOOTSTRAP_ADMIN=admin

# Whether new users can register. Set to false after creating required accounts.
REGISTRATION_OPEN=true

# Maximum file upload size in bytes (default 100 MiB).
MAX_UPLOAD_BYTES=104857600

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
