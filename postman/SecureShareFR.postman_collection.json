{
  "info": {
    "_postman_id": "secureshare-fr-2.0.0",
    "name": "SecureShareFR API",
    "description": "Complete API collection for SecureShareFR — a zero-knowledge, end-to-end encrypted file sharing platform.\n\n**Setup:**\n1. Import both `SecureShareFR.postman_collection.json` and `SecureShareFR.postman_environment.json`\n2. Select the `SecureShareFR Local` environment\n3. Run the **Health & Meta** folder first to verify connectivity\n4. Run **Auth & Sessions > Register (admin)** to create the admin account\n5. Proceed through the other folders in order\n\n**CSRF:** All state-changing requests include `X-SecureShare-CSRF: 1` via the collection-level pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": { "major": 2, "minor": 0, "patch": 0 }
  },
  "auth": null,
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically set CSRF header on all state-changing requests",
          "pm.request.headers.add({ key: 'X-SecureShare-CSRF', value: '1' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "authorityUrl", "value": "http://localhost:7000", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health & Meta",
      "description": "Service liveness and application metadata.",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Returns 200 when the API service is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has status:ok', () => pm.expect(pm.response.json().status).to.equal('ok'));",
                  "pm.test('No x-powered-by header', () => pm.expect(pm.response.headers.get('x-powered-by')).to.be.null);",
                  "pm.test('Has HSTS header', () => pm.expect(pm.response.headers.get('strict-transport-security')).to.not.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Authority Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authorityUrl}}/authority/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('service is authority', () => pm.expect(pm.response.json().service).to.equal('authority'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API Meta (upload limits)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/meta"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has maxUploadBytes', () => pm.expect(json.maxUploadBytes).to.be.a('number'));",
                  "pm.environment.set('maxUploadBytes', json.maxUploadBytes);"
                ]
              }
            }
          ]
        },
        {
          "name": "Authority Params (FAME public key)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authorityUrl}}/authority/params"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has publicKey with FAME scheme', () => pm.expect(json.publicKey?.scheme).to.equal('fame-bls12381-v1'));",
                  "pm.test('Has fingerprint', () => pm.expect(json.fingerprint).to.be.a('string'));",
                  "pm.environment.set('authorityFingerprint', json.fingerprint);"
                ]
              }
            }
          ]
        },
        {
          "name": "Integration Status (live checks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/status",
            "description": "Real-time status of all 6 integrations: DB, authority, storage, webhooks, Nginx proxy, HTTPS."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 207', () => pm.expect(pm.response.code).to.be.oneOf([200, 207]));",
                  "const json = pm.response.json();",
                  "pm.test('Has checks object', () => pm.expect(json.checks).to.be.an('object'));",
                  "pm.test('Database check present', () => pm.expect(json.checks.database).to.exist);",
                  "pm.test('Swagger check present', () => pm.expect(json.checks.swagger).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI (GET /docs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs",
            "description": "Should return an HTML page with the Swagger UI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is HTML', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/html'));",
                  "pm.test('Contains swagger-ui', () => pm.expect(pm.response.text()).to.include('swagger-ui'));",
                  "pm.test('Assets are self-hosted (no CDN)', () => pm.expect(pm.response.text()).to.not.include('unpkg.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI JSON Spec",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/openapi.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('OpenAPI 3.0.3', () => pm.expect(json.openapi).to.equal('3.0.3'));",
                  "pm.test('Title is SecureShareFR API', () => pm.expect(json.info.title).to.include('SecureShareFR'));",
                  "pm.test('Has paths', () => pm.expect(Object.keys(json.paths).length).to.be.greaterThan(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI assets (self-hosted)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs/assets/swagger-ui.css"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Served from this origin', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/css'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth & Sessions",
      "description": "Account registration, login, session management, and security controls.",
      "item": [
        {
          "name": "Get KDF Params (known user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/params?username={{adminUsername}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "params"],
              "query": [{ "key": "username", "value": "{{adminUsername}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Algorithm is pbkdf2-sha256', () => pm.expect(json.alg).to.equal('pbkdf2-sha256'));",
                  "pm.test('Iterations >= 600000', () => pm.expect(json.iterations).to.be.at.least(600000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get KDF Params (unknown user – anti-enumeration)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/params?username=nonexistent_user_xyz_abc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "params"],
              "query": [{ "key": "username", "value": "nonexistent_user_xyz_abc" }]
            },
            "description": "Should return structurally valid fake KDF params to prevent account enumeration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 (enumeration resistance)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns valid KDF structure', () => pm.expect(json.alg).to.equal('pbkdf2-sha256'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (admin) ★",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"kdf\": { \"alg\": \"pbkdf2-sha256\", \"iterations\": 600000, \"salt\": \"demo-salt-value-123\" },\n  \"authKey\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n  \"encPublicKey\": { \"kty\": \"EC\", \"crv\": \"P-256\", \"x\": \"demo\", \"y\": \"demo\", \"key_ops\": [] },\n  \"sigPublicKey\": { \"kty\": \"EC\", \"crv\": \"P-256\", \"x\": \"demo\", \"y\": \"demo\", \"key_ops\": [] },\n  \"vault\": \"demo-encrypted-vault-base64url\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "⚠️ This request uses simplified demo values. In production the browser performs real PBKDF2 key derivation. Use the actual web UI for a real registration.\n\nIf the account already exists this will return 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Has user object', () => pm.expect(json.user).to.exist);",
                  "  pm.test('Has role', () => pm.expect(json.user.role).to.be.a('string'));",
                  "  pm.environment.set('userId', json.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (invalid credentials) ✗",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"{{adminUsername}}\", \"authKey\": \"wrong-key-definitely-invalid-aaaaaaa\" }"
            },
            "description": "Should return 401. Demonstrates error handling and rate limiting."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 (invalid credentials)', () => pm.response.to.have.status(401));",
                  "pm.test('Has error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (missing CSRF header) ✗",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-SecureShare-CSRF", "value": "", "disabled": true }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"username\": \"{{adminUsername}}\", \"authKey\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\" }"
            },
            "description": "Should return 403. The collection pre-request script normally adds the CSRF header; here it's removed to demonstrate the CSRF protection."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.request.headers.remove('X-SecureShare-CSRF');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 (CSRF rejected)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Session (unauthenticated) ✗",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 (not signed in)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
