    {
      "name": "4. Files & Encrypted Blobs",
      "description": "File registration, ciphertext upload, download, policy management, and deletion.",
      "item": [
        {
          "name": "List Files (unauthenticated) ✗",
          "request": {
            "method": "GET",
            "header": [],
