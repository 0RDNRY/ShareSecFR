              "raw": "{ \"fileId\": \"../traversal-attempt\", \"encMeta\": \"x\", \"abeEnvelope\": {\"policy\":\"role:test\"}, \"ownerEnvelope\": \"x\", \"manifest\": {\"v\":1,\"ownerId\":\"x\",\"ciphertext\":{\"sha256\":\"x\",\"size\":1}}, \"signature\": \"x\" }",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Should return 400 or 401 (invalid fileId format)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 or 401', () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));",
                  "pm.test('Has error field', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download Non-existent File ✗",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/files/AAAAAAAAAAAAAAAAAAAAAA/blob",
            "description": "Should return 401 (not signed in) or 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 401 or 404', () => pm.expect(pm.response.code).to.be.oneOf([401, 404]));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Webhooks",
      "description": "Webhook endpoint registration, delivery testing, and log inspection.",
      "item": [
        {
          "name": "List Supported Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/webhooks/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has events array', () => pm.expect(json.events).to.be.an('array'));",
                  "pm.test('Has file.uploaded event', () => pm.expect(json.events).to.include('file.uploaded'));",
                  "pm.test('Has auth.login.succeeded', () => pm.expect(json.events).to.include('auth.login.succeeded'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Webhook Endpoint (unauthenticated) ✗",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/webhooks",
            "body": {
              "mode": "raw",
              "raw": "{ \"url\": \"https://webhook.site/test\", \"secret\": \"my-webhook-secret-min-16-chars\", \"events\": [\"file.uploaded\"] }"
            },
            "description": "Should return 401 — authentication required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 401 (not signed in)', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Register Webhook – SSRF blocked URL ✗",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/webhooks",
            "body": {
              "mode": "raw",
              "raw": "{ \"url\": \"http://localhost:27017/evil\", \"secret\": \"my-webhook-secret-min-16-chars\", \"events\": [\"file.uploaded\"] }",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Should return 400 (SSRF protection). Localhost/private IPs are blocked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 or 401', () => pm.expect(pm.response.code).to.be.oneOf([400, 401]));",
                  "if (pm.response.code === 400) {",
                  "  pm.test('SSRF error message', () => pm.expect(pm.response.json().error).to.include('SSRF'));",
                  "}"
                ]
              }
            }
          ]
        },
