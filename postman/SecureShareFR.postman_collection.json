    {
      "name": "7. Security & Error Handling",
      "description": "Demonstrates security controls: input validation, rate limiting, CSRF, authentication.",
      "item": [
        {
          "name": "Invalid JSON body ✗",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{ invalid json }", "options": { "raw": { "language": "text" } } },
            "description": "Should return 400 (malformed JSON)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 (malformed JSON)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing required fields ✗",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "description": "Should return 400 (Zod validation failure)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 (validation error)', () => pm.response.to.have.status(400));",
                  "pm.test('Has error field', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 – Unknown route ✗",
