# Local development settings, used by `npm run dev` (plain Node processes).
# `npm run setup` copies this to .env and creates the files under ./secrets.
# Docker deployments use deploy/.env instead (see docs/DEPLOYMENT.md).

LOG_LEVEL=info
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1

# --- API service
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/secureshare
STORAGE_DIR=./data/blobs
MAX_UPLOAD_BYTES=104857600
JWT_TTL_SECONDS=1800
BOOTSTRAP_ADMIN=admin
AUTHORITY_INTERNAL_URL=http://127.0.0.1:7001
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private.pem
SERVER_SECRET_FILE=./secrets/server_secret

# --- Attribute authority
AUTHORITY_PORT=7000
AUTHORITY_INTERNAL_PORT=7001
AUTHORITY_MONGODB_URI=mongodb://127.0.0.1:27017/secureshare_authority
AUTHORITY_KEK_FILE=./secrets/authority_kek

# --- Shared by both services
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public.pem
INTERNAL_TOKEN_FILE=./secrets/internal_token
